# ─────────────────────────────────────────────────────────────────────────────
# GoldenHour — Environment Variables Example
# Copy this file to infra/env/.env and fill in real values before running.
# All variables are consumed by services/core and services/ml via pydantic-settings.
# §22 of technical.md is the canonical reference.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg DSN used by SQLAlchemy async engine in core.
DATABASE_URL=postgresql+asyncpg://gh:gh@postgres:5432/goldenhour

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for: pub/sub fan-out, arq job queue, rate limiting, leader lock,
# live GPS cache, idempotency key store.
REDIS_URL=redis://redis:6379/0

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# HS256 secret — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_generate_a_random_64_byte_hex_string
# Key-ID embedded in JWT header — increment when rotating keys.
JWT_KID=k1
# Access token lifetime in minutes (default 15).
JWT_ACCESS_EXPIRE_MIN=15
# Refresh token lifetime in days (default 7).
JWT_REFRESH_EXPIRE_DAYS=7

# ── ML Service ────────────────────────────────────────────────────────────────
# Base URL that core uses to reach the ML service.
ML_BASE_URL=http://ml:8001
# real  → call the real ML endpoints (default for production)
# mock  → deterministic schema-valid responses derived from input hash (CI/dev)
ML_MODE=mock
# Comma-separated list of capabilities to mock even when ML_MODE=real.
# Useful when a single model is not yet loaded.
# Values: stt,extract,triage,prank_score,duplicate_check,dispatch_rank,
#         followup,first_aid,handover,resources,eta,road_comfort,hospital_rank,
#         bed_nowcast,demand_forecast,preposition,mci_allocate,translate,tts
ML_MOCK_CAPABILITIES=

# ── OSRM (routing) ────────────────────────────────────────────────────────────
# Self-hosted OSRM backend loaded with the Pune MLD graph.
OSRM_URL=http://osrm:5000
# Mapbox Directions API token for traffic-aware ETAs.
MAPBOX_TOKEN=pk.eyJ1IjoiQ0hBTkdFX01FIiwiYSI6IkNIQU5HRV9NRSJ9.CHANGE_ME
# live     → hit Mapbox + OSRM on every call
# fixtures → use pre-recorded Pune route fixtures (no network)
GEO_MODE=fixtures

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# URL of the locally running Ollama instance.
OLLAMA_URL=http://ollama:11434
# Model tag to use for extraction (§9.2) and handover note (§9.9).
LLM_MODEL=qwen2.5:7b-instruct
# Timeout in seconds for LLM calls.
LLM_TIMEOUT_SEC=8

# ── SMS Gateway ───────────────────────────────────────────────────────────────
# real → call the real SMS provider API
# fake → write to notifications table + local log (default for dev/testing)
SMS_MODE=fake
# textbee | httpsms — which Android gateway app is configured.
SMS_PROVIDER=textbee
# API key for the selected SMS provider.
SMS_API_KEY=CHANGE_ME
# Shared secret used to authenticate inbound webhook calls from the gateway.
SMS_WEBHOOK_SECRET=CHANGE_ME_random_32_bytes
# The gateway phone number that callers SMS to.
SMS_GATEWAY_NUMBER=+919999900000

# ── Telegram ──────────────────────────────────────────────────────────────────
# real → use the real Telegram Bot API
# fake → log messages locally without sending
TELEGRAM_MODE=fake
# Token from BotFather.
TELEGRAM_BOT_TOKEN=1234567890:AACHANGE_ME_BOT_TOKEN
# Secret included in the X-Telegram-Bot-Api-Secret-Token header for webhook auth.
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_random_32_bytes
# Numeric ID of the team group chat where escalation alerts are posted.
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# ── Firebase Cloud Messaging (push notifications) ─────────────────────────────
# Firebase project ID.
FCM_PROJECT_ID=goldenhour-CHANGE_ME
# Path to the FCM service account JSON key file *inside the container*,
# OR the entire JSON content (base64-encoded) for secret managers.
FCM_SERVICE_ACCOUNT_JSON=/run/secrets/fcm_service_account.json

# ── Public URL (tunnel) ───────────────────────────────────────────────────────
# Used for building absolute URLs (family tracking links, webhook registration,
# one-time ops links, TTS audio URLs).
# Set to your Cloudflare Tunnel / ngrok domain.
PUBLIC_BASE_URL=https://goldenhour-CHANGE_ME.trycloudflare.com

# ── Simulator ─────────────────────────────────────────────────────────────────
# true  → the simulator endpoints and scenario runner are active.
# false → disable in production.
SIM_ENABLED=true
# Global time multiplier for all timers (1–10).
SIM_SPEED=1

# ── System constants — overrides (see §4 of technical.md for defaults) ─────────
# Leave commented-out to use the spec defaults defined in services/core/app/config.py.

# DISPATCH_RADII_KM=5,10,20
# OFFERS_PER_ROUND=4
# OFFER_EXPIRY_SEC=20
# DISPATCH_ROUND_INTERVAL_SEC=30
# NO_AMBULANCE_ESCALATE_AFTER_ROUND=3
# HOSPITAL_TIMEOUT_CRITICAL_SEC=45
# HOSPITAL_TIMEOUT_OTHER_SEC=60
# HOLD_PENDING_EXTRA_SEC=10
# HOLD_CONFIRMED_MIN_SEC=600
# HEARTBEAT_INTERVAL_SEC=5
# SIGNAL_WEAK_SEC=30
# SIGNAL_LOST_SEC=120
# OFFLINE_HOLD_GRACE_EXTRA_SEC=900
# ESCALATION_REPEAT_SEC=60
# ESCALATION_DEFAULT_SEC=120
# FRESH_MAX_MIN=10
# AGING_MAX_MIN=30
# DUPLICATE_RADIUS_M=500
# DUPLICATE_WINDOW_MIN=15
# DUPLICATE_SIM=0.80
# MCI_PATIENT_THRESHOLD=5
# TRIAGE_REVIEW_CONFIDENCE=0.60
# PRANK_VERIFY_WAIT_SEC=30
# GEOFENCE_SCENE_M=75
# GEOFENCE_HOSPITAL_M=150
# IDLE_ALERT_SEC=90
# IDLE_REASSIGN_SEC=150
# OFFLOAD_DELAY_ALERT_MIN=15
# DETERIORATION_DIVERT_GAIN_SEC=180
# IDEMPOTENCY_TTL_H=24
# OPS_LINK_TTL_MIN=15
# OPS_SESSION_H=2
# SWEEPER_INTERVAL_SEC=5
# PREPOSITION_INTERVAL_MIN=15
# LEADER_LOCK_TTL_MS=10000
# LEADER_RENEW_SEC=3

# ── Observability ─────────────────────────────────────────────────────────────
# Log level for uvicorn and application loggers. Values: debug|info|warning|error
LOG_LEVEL=info
# Set to 1 to emit Prometheus metrics at /metrics.
ENABLE_METRICS=1

# ── Audio storage ─────────────────────────────────────────────────────────────
# Object storage bucket for voice SOS recordings.
# For local dev, set AUDIO_STORAGE_MODE=local and files are stored in /tmp/audio.
AUDIO_STORAGE_MODE=local
# AUDIO_BUCKET=goldenhour-audio
# AUDIO_STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# AUDIO_STORAGE_ACCESS_KEY=CHANGE_ME
# AUDIO_STORAGE_SECRET_KEY=CHANGE_ME
# Audio objects are deleted this many days after emergency closure (§18).
AUDIO_RETENTION_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origin of the Next.js frontend; CORS is locked to this value (§18).
CORS_ORIGIN=http://localhost:3000
